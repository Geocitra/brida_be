generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum LogStatus {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SessionType {
  QA_CHAT
  ARTICLE_GENERATOR
}

enum ArticleLength {
  SHORT
  MEDIUM
  LONG
}

enum InteractionType {
  MANUAL_INPUT
  SUGGESTION_CHIP
  SYSTEM_GENERATED
}

model ReportDocument {
  id                     String                 @id @default(uuid()) @db.Uuid
  title                  String
  fileUrl                String
  mimeType               String
  checksumHash           String                 @unique
  status                 DocumentStatus         @default(PENDING)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  metadata               DocumentMetadata?
  chunks                 DocumentChunk[]
  logs                   ExtractionLog[]
  aiLogs                 AiAnalysisLog[]
  chatSessions           ChatSession[]
  generatedReportSources ReportSourceRef[]
  chatSessionSources     ChatSessionSourceRef[]
  baselines              IndicatorBaseline[]
  realizations           IndicatorRealization[]
  infographicSessions    InfographicSession[]

  @@map("report_documents")
}

model DocumentMetadata {
  id               String            @id @default(uuid()) @db.Uuid
  documentId       String            @unique @db.Uuid
  fileSizeBytes    BigInt
  pageCount        Int               @default(0)
  totalTokenCount  Int               @default(0)
  category         String            @default("General Report")
  uploadedBy       String            @default("SYSTEM_STAF")
  docType          String            @default("REALIZATION")
  
  // Bidang Baru: Dukungan Pelacakan Dokumen Virtual Hasil Scraping Eksternal
  sourceUrl        String?           @map("source_url") @db.VarChar(2048)
  externalMetadata Json?             @map("external_metadata") @default("{}")
  
  categoryId       String?           @db.Uuid
  opdId            String?           @db.Uuid

  createdAt        DateTime          @default(now())

  document         ReportDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  categoryRef      DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  opd              OPD?              @relation(fields: [opdId], references: [id], onDelete: SetNull)

  @@map("document_metadata")
}

model DocumentChunk {
  id                 String               @id @default(uuid()) @db.Uuid
  documentId         String               @db.Uuid
  chunkIndex         Int
  rawText            String               @db.Text
  tokenCount         Int
  embedding          String?              @db.Text
  detected_districts String[]             @default([])
  district_density   Json?                @default("{}")
  createdAt          DateTime             @default(now())

  document           ReportDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  locations          GeospatialLocation[]

  @@index([documentId, chunkIndex])
  @@index([detected_districts], type: Gin)
  @@map("document_chunks")
}

model ExtractionLog {
  id              String         @id @default(uuid()) @db.Uuid
  documentId      String         @db.Uuid
  status          LogStatus      @default(INFO)
  errorMessage    String?        @db.Text
  executionTimeMs Int            @default(0)
  createdAt       DateTime       @default(now())

  document        ReportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("extraction_logs")
}

model GeospatialLocation {
  id              String                    @id @default(uuid()) @db.Uuid
  chunkId         String                    @db.Uuid
  locationName    String
  latitude        Float
  longitude       Float
  confidenceScore Float                     @default(1.0)
  createdAt       DateTime                  @default(now())

  chunk           DocumentChunk             @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("geospatial_locations")
}

model AiAnalysisLog {
  id              String         @id @default(uuid()) @db.Uuid
  documentId      String         @db.Uuid
  userQuery       String         @db.Text
  status          LogStatus      @default(SUCCESS)
  executionTimeMs Int            @default(0)
  tokenCount      Int            @default(0)
  responsePayload String?        @db.Text
  errorMessage    String?        @db.Text
  createdAt       DateTime       @default(now())

  document        ReportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ai_analysis_logs")
}

model ChatSession {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  documentId      String?                @db.Uuid
  sessionType     SessionType            @default(QA_CHAT)
  title           String                 @default("Sesi Analisis Kasus")
  articleTitle    String?                @db.Text
  targetLength    ArticleLength?         @default(MEDIUM)
  tone            String?                @default("solutif")
  runningSummary  String?                @db.Text
  
  // Bidang Baru: State Synchronization Cache untuk Lembar Kerja Kanan (Pane Kanan)
  currentDraft       String?                @db.Text 
  
  // Bidang Baru: State Dokumen Editorial Visual (Native Semantic HTML / ProseMirror Canvas)
  editorDocumentState String?               @db.Text

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Hubungan Mandiri (Self-Referencing Relation) untuk Transisi Sesi
  parentSessionId    String?                @db.Uuid
  parentSession      ChatSession?           @relation("SessionTransition", fields: [parentSessionId], references: [id], onDelete: SetNull)
  derivedSessions    ChatSession[]          @relation("SessionTransition")

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           ReportDocument?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]
  sources            ChatSessionSourceRef[]
  mediaAssets        SessionMediaAsset[]

  @@map("chat_sessions")
}

model SessionMediaAsset {
  id            String      @id @default(uuid()) @db.Uuid
  sessionId     String      @db.Uuid
  fileUrl       String      // Path fisik/publik: /uploads/media/...
  fileName      String
  mimeType      String
  fileSizeBytes BigInt
  createdAt     DateTime    @default(now())

  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_media_assets")
}

model ChatSessionSourceRef {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @db.Uuid
  documentId   String          @db.Uuid
  createdAt    DateTime        @default(now())

  session      ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document     ReportDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, documentId])
  @@map("chat_session_source_refs")
}

model ChatMessage {
  id              String             @id @default(uuid()) @db.Uuid
  sessionId       String             @db.Uuid
  role            MessageRole
  content         String             @db.Text
  tokenCount      Int                @default(0)
  interactionType InteractionType    @default(MANUAL_INPUT)
  metadata        Json?
  createdAt       DateTime           @default(now())

  session         ChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // Relasi Baru: Menghubungkan Pesan Obrolan dengan Lampiran Multimedia/File
  attachments     MessageAttachment[]

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// Model Baru: Menyimpan Metadata File/Screenshot yang Dikirim di Ruang Obrolan
model MessageAttachment {
  id            String      @id @default(uuid()) @db.Uuid
  messageId     String      @db.Uuid
  fileUrl       String      // Lokasi path fisik penyimpanan file di server lokal / S3 Bucket
  fileName      String
  mimeType      String
  fileSizeBytes BigInt
  createdAt     DateTime    @default(now())

  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model GeneratedReport {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  title            String
  reportType       String            @default("NOTA_DINAS_BUPATI")
  documentIdsHash  String            @db.Text
  executiveSummary String            @db.Text
  contentPayload   Json
  tokenCount       Int               @default(0)
  llmProvider      String            @default("GEMINI_FLASH")
  status           DocumentStatus    @default(READY)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources          ReportSourceRef[]

  @@index([documentIdsHash])
  @@map("generated_reports")
}

model ReportSourceRef {
  id           String          @id @default(uuid()) @db.Uuid
  reportId     String          @db.Uuid
  documentId   String          @db.Uuid
  createdAt    DateTime        @default(now())

  report       GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  document     ReportDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([reportId, documentId])
  @@map("report_source_refs")
}

model IndicatorBaseline {
  id            String         @id @default(uuid()) @db.Uuid
  documentId    String         @map("document_id") @db.Uuid
  indicatorName String         @map("indicator_name")
  targetValue   Float          @map("target_value")
  unit          String         @default("M")
  timeframe     String         @default("2026")
  createdAt     DateTime       @default(now()) @map("created_at")

  document      ReportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("indicator_baselines")
}

model IndicatorRealization {
  id               String         @id @default(uuid()) @db.Uuid
  documentId       String         @map("document_id") @db.Uuid
  indicatorName    String         @map("indicator_name")
  realizationValue Float          @map("realization_value")
  unit             String         @default("M")
  timeframe        String         @default("2026")
  createdAt     DateTime       @default(now()) @map("created_at")

  document         ReportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("indicator_realizations")
}

model DeviationAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  baselineDocId       String?  @map("baseline_doc_id") @db.Uuid
  realizationDocId    String?  @map("realization_doc_id") @db.Uuid
  indicatorName       String   @map("indicator_name")
  targetValue         Float    @map("target_value")
  realizationValue    Float    @map("realization_value")
  deviationValue      Float    @map("deviation_value")
  deviationPercentage Float    @map("deviation_percentage")
  urgencyStatus       String   @map("urgency_status")
  causalFactors       Json     @map("causal_factors")
  recommendations     Json     @map("recommendations")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("deviation_analyses")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  nip          String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  opdId        String?  @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  opd              OPD?              @relation(fields: [opdId], references: [id], onDelete: SetNull)
  chatSessions     ChatSession[]
  generatedReports GeneratedReport[]
  infographicSessions InfographicSession[]

  @@map("users")
}

model District {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  latitude       Float
  longitude      Float
  aliases        String[] @default([])
  luasWilayah    Float    @default(0.0)
  jumlahPenduduk Int      @default(0)
  deskripsi      String   @default("")
  batasWilayah   String   @default("")
  images         String[] @default([])
  suggestions    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("districts")
}

model DocumentCategory {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @unique
  code           String             @unique
  description    String?
  analyticalRole String             @default("REFERENCE") @map("analytical_role")
  documents      DocumentMetadata[]
  createdAt      DateTime           @default(now())

  @@map("document_categories")
}

model OPD {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  code      String             @unique
  headName  String?            @map("head_name")
  headPhone String?            @map("head_phone")
  users     User[]
  documents DocumentMetadata[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("opds")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ── MODEL BARU: Sesi Percakapan Pembuatan Poster ──
model InfographicSession {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @db.Uuid
  documentId  String?             @db.Uuid
  title       String              @default("Sesi Poster Baru")
  topic       String              @db.Text
  aspectRatio String              @default("9:16")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    ReportDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  posters     InfographicPoster[]

  @@map("infographic_sessions")
}

enum PosterGenerationProfile {
  V1_BAKED_FOOTER
  V2_CLEAN_CANVAS
}

// ── MODEL BARU: Riwayat Versi Gambar Poster (v1, v2, revisi) ──
model InfographicPoster {
  id                String                    @id @default(uuid()) @db.Uuid
  sessionId         String                    @db.Uuid
  versionNumber     Int                       @default(1)
  userPrompt        String                    @db.Text
  revisedPrompt     String?                   @db.Text
  aiCommentary      String?                   @db.Text
  imageUrl          String                    @db.VarChar(1024)
  aspectRatio       String                    @default("9:16")
  tokenCount        Int                       @default(0)
  generationProfile PosterGenerationProfile   @default(V1_BAKED_FOOTER)
  createdAt         DateTime                  @default(now())

  session           InfographicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  branding          InfographicPosterBranding?

  @@index([sessionId, versionNumber])
  @@map("infographic_posters")
}

// ── MODEL BARU: Metadata Branding (Header, Logo, Footer) per Poster ──
model InfographicPosterBranding {
  id             String            @id @default(uuid()) @db.Uuid
  posterId       String            @unique @db.Uuid
  headerEnabled  Boolean           @default(false)
  logoUrl        String?           @db.VarChar(1024)
  institution    String?           @db.VarChar(160)
  subInstitution String?           @db.VarChar(160)
  footerEnabled  Boolean           @default(false)
  footerText     String?           @db.VarChar(500)
  layoutConfig   Json              @default("{}")
  composedUrl    String?           @db.VarChar(1024)
  brandingHash   String?           @db.VarChar(64)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  poster         InfographicPoster @relation(fields: [posterId], references: [id], onDelete: Cascade)

  @@map("infographic_poster_branding")
}